    {
        "id": "ad588b6d60817b3a",
        "type": "function",
        "z": "6aca088ecdd6ec8e",
        "name": "function 105",
        "func": "// Initialize context variables if they don't exist\nif (typeof context.get('buttonClicked') === 'undefined') {\n    context.set('buttonClicked', false);\n}\n\n// Check if the message is from the UI button\nif (msg.payload === 'Play') {\n    context.set('buttonClicked', true);\n    return null; // Do nothing else if it's from the button\n}\n\n// Check if the message is from the inject node\nif (msg.topic === 'check') {\n    // Check if the button was clicked\n    if (context.get('buttonClicked')) {\n        context.set('buttonClicked', false); // Reset button state\n        msg.payload = { \"action\": \"Button was clicked!\" };\n        return msg; // Send the message to trigger the file read\n    } else {\n        return null; // Do nothing if the button was not clicked\n    }\n}\n\nreturn null; // Return nothing by default\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
