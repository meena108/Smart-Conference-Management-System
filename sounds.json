        "id": "b9989c935129b82e",
        "type": "function",
        "z": "6aca088ecdd6ec8e",
        "name": "function 97",
        "func": "// Check if the incoming payload is 'open'\nif (msg.payload === \"open\") {\n    // Create the first message with a topic 'control' and payload 'open'\n    var msg1 = { payload: \"open\", topic: \"control\" };\n\n    // Create the second message with only the topic information\n    var msg2 = { topic: msg.topic };\n\n    // Return both messages as separate outputs\n    return [[msg1, msg2]];\n}\n",
